{
  "name": "@prinpo/stack",
  "version": "0.1.0",
  "description": "Composable Bun, Elysia, Eden, and TanStack Router integrations.",
  "homepage": "https://github.com/prinpo/stack#readme",
  "bugs": {
    "url": "https://github.com/prinpo/stack/issues"
  },
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prinpo/stack.git"
  },
  "bin": {
    "stack": "./src/cli/main.ts"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": "./src/client.ts",
    "./devtools": "./src/devtools.ts",
    "./env": "./src/env.ts",
    "./env/server": "./src/env/server.ts",
    "./env/defaults": "./src/env/.env.schema",
    "./env/vite": "./src/env/vite.ts",
    "./logger": "./src/logger.ts",
    "./logger/elysia": "./src/logger/elysia.ts",
    "./logger/client": "./src/logger/client.ts",
    "./query": "./src/query.ts",
    "./react": "./src/react.tsx",
    "./server": "./src/server.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "package:check": "bun --no-env-file scripts/release/package.ts",
    "dev": "bun run stack dev",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "example:check": "cd examples/fullstack && bunx --bun vp check",
    "research:varlock": "bun --no-env-file scripts/probe-varlock.ts",
    "stack": "cd examples/fullstack && bun run stack"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/static": "1.4.10",
    "@evlog/cli": "0.11.1",
    "@rollup/plugin-replace": "6.0.3",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/router-plugin": "1.168.46",
    "@vitejs/plugin-react": "6.1.2",
    "chalk": "6.0.1",
    "citty": "0.2.2",
    "elysia": "1.4.30",
    "evlog": "2.34.0",
    "exact-mirror": "0.2.7",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3",
    "varlock": "1.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.4.4",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bumpp": "^12.3.0",
    "happy-dom": "20.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  },
  "engines": {
    "bun": ">=1.4.4"
  }
}
