{
  "name": "@prinpo/stack",
  "version": "0.0.0",
  "description": "Composable Bun, Elysia, Eden, and TanStack Router integrations.",
  "homepage": "https://github.com/prinpo/stack#readme",
  "bugs": {
    "url": "https://github.com/prinpo/stack/issues"
  },
  "license": "MIT AND Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prinpo/stack.git"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "src",
    "patches"
  ],
  "type": "module",
  "sideEffects": [
    "./src/env/auto-load.ts",
    "./dist/env/auto-load.js"
  ],
  "exports": {
    "./client": "./src/client.ts",
    "./devtools": "./src/devtools.ts",
    "./env": "./src/env.ts",
    "./env/auto-load": "./src/env/auto-load.ts",
    "./env/elysia": "./src/env/elysia.ts",
    "./env/vite": "./src/env/vite.ts",
    "./logger": "./src/logger.ts",
    "./logger/elysia": "./src/logger/elysia.ts",
    "./logger/client": "./src/logger/client.ts",
    "./query": "./src/query.ts",
    "./react": "./src/react.tsx",
    "./server": "./src/server.ts",
    "./vite": "./src/vite.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp run example:dev",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "example:dev": "cd examples/fullstack && bun run dev",
    "example:check": "cd examples/fullstack && bunx --bun vp check",
    "research:varlock": "bun --no-env-file scripts/probe-varlock.ts",
    "example:logs": "cd examples/fullstack && bun run logs",
    "example:logs:errors": "cd examples/fullstack && bun run logs:errors",
    "example:logs:json": "cd examples/fullstack && bun run logs:json"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/static": "1.4.10",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/router-plugin": "1.168.46",
    "@varlock/vite-integration": "1.5.4",
    "@vitejs/plugin-react": "6.1.2",
    "elysia": "1.4.30",
    "evlog": "2.34.0",
    "exact-mirror": "0.2.7",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3",
    "varlock": "1.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@evlog/cli": "0.11.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bumpp": "^12.3.0",
    "happy-dom": "20.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "patchedDependencies": {
    "varlock@1.23.0": "patches/varlock@1.23.0.patch",
    "@varlock/vite-integration@1.5.4": "patches/@varlock%2Fvite-integration@1.5.4.patch"
  }
}
