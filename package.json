{
  "name": "@prinpo/stack-repo",
  "version": "0.0.0",
  "private": true,
  "description": "Composable Bun, Elysia, Eden, and TanStack Router integrations.",
  "homepage": "https://github.com/prinpo/stack#readme",
  "bugs": {
    "url": "https://github.com/prinpo/stack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prinpo/stack.git"
  },
  "workspaces": [
    "src",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "dev": "vp run example:dev",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "example:dev": "cd examples/fullstack && bun run dev",
    "example:check": "cd examples/fullstack && bunx --bun vp check"
  },
  "devDependencies": {
    "@prinpo/stack": "workspace:*",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bumpp": "^12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "^1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  }
}
