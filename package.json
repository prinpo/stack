{
  "name": "@prinpo/stack",
  "version": "0.0.0",
  "description": "Composable Bun, Elysia, Eden, and TanStack Router integrations.",
  "homepage": "https://github.com/prinpo/stack#readme",
  "bugs": {
    "url": "https://github.com/prinpo/stack/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prinpo/stack.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": "./dist/client.mjs",
    "./devtools": "./dist/devtools.mjs",
    "./react": "./dist/react.mjs",
    "./server": "./dist/server.mjs",
    "./vite": "./dist/vite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "prepare": "vp config",
    "example:setup": "vp run package:artifact && cd examples/fullstack && bunx --bun vp install --force",
    "example:dev": "cd examples/fullstack && bun run dev",
    "example:check": "cd examples/fullstack && bunx --bun vp check",
    "package:artifact": "vp run build && mkdir -p .artifacts && bun pm pack --ignore-scripts --filename .artifacts/stack.tgz",
    "check:package": "vp run package:artifact && bun scripts/check-package.ts"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@elysiajs/eden": "1.4.9",
    "@elysiajs/static": "1.4.10",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-router-devtools": "1.167.2",
    "@tanstack/router-generator": "1.167.44",
    "@tanstack/router-plugin": "1.168.46",
    "@vitejs/plugin-react": "6.1.2",
    "elysia": "1.4.30",
    "exact-mirror": "0.2.7",
    "file-type": "22.2.0",
    "openapi-types": "12.1.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "bumpp": "^12.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "^1.2.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  }
}
