# Copy to .env.development.local for personal development overrides,
# or .env.production.local on the deployment host. Both are gitignored.
# Stack owns these types and defaults; override their values here if needed.
HOST=127.0.0.1
PORT=3000
SERVER_PUBLIC_DYNAMIC=my-server-public-dynamic-value
SERVER_SECRET_DYNAMIC=demo-only-personal-dynamic-value

# Declare application credentials in .env.schema first, keeping them server-only.
# STRIPE_SECRET_KEY=your-sandbox-key
# OPENAI_API_KEY=your-personal-key
