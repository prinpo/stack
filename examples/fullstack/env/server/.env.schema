# @defaultSensitive=true
# @redact=false @preventLeaks=false
# @generateTsTypes(path=../../src/env-gen/server.ts, exposeEnv=local, icons=false)
# ---

# @public @dynamic @type=string
LOG_DIR=.evlog/logs

# File-backed SQLite for the database example. This value is resolved at startup.
# @sensitive @dynamic @required @type=string
DATABASE_URL=sqlite://example.sqlite

# App-owned BullMQ connection. Override for deployed Redis or compatible services.
# @sensitive @dynamic @required @type=url(allowedProtocols=[redis])
JOBS_REDIS_URL=redis://127.0.0.1:6379

# Validated during builds and read by the server at startup.
# @public @static @required @type=string
SERVER_PUBLIC_STATIC=

# Resolved and validated at server startup.
# @public @dynamic @required @type=string
SERVER_PUBLIC_DYNAMIC=

# Dummy sandbox value, intentionally returned by /api/env. Never use real credentials here.
# @sensitive @static @required @type=string
SERVER_SECRET_STATIC=

# Dummy sandbox value, intentionally returned by /api/env. Never use real credentials here.
# @sensitive @dynamic @required @type=string
SERVER_SECRET_DYNAMIC=

# Auth deployment settings: never resolved by schema generation or builds.
# @sensitive @dynamic @required @type=string
BETTER_AUTH_SECRET=

# @public @dynamic @required @type=url
BETTER_AUTH_URL=

# Jobs processed concurrently by each utilities worker.
# @public @dynamic @required @type=number(min=1, isInt=true)
JOBS_CONCURRENCY=4

# Example Mailpit delivery endpoint. Production auth requires a configured sender.
# @public @dynamic @optional @type=url(allowedProtocols=[http,https])
EXAMPLE_AUTH_MAIL_URL=http://127.0.0.1:8025
