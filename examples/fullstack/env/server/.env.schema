# @public @dynamic @type=string
PRINPO_LOG_DIR=.evlog/logs

# Validated during builds and read by the server at startup.
# @public @static @required @type=string
SERVER_PUBLIC_STATIC=

# Resolved and validated at server startup.
# @public @dynamic @required @type=string
SERVER_PUBLIC_DYNAMIC=

# Dummy sandbox value, intentionally returned by /api/env. Never use real credentials here.
# @sensitive @static @required @type=string
SERVER_SECRET_STATIC=

# Dummy sandbox value, intentionally returned by /api/env. Never use real credentials here.
# @sensitive @dynamic @required @type=string
SERVER_SECRET_DYNAMIC=
