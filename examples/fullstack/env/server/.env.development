SERVER_PUBLIC_DYNAMIC=server-public-dynamic-development
SERVER_SECRET_DYNAMIC=demo-only-server-secret-dynamic-development

BETTER_AUTH_SECRET=development-only-stack-example-secret-change-for-production
# Built previews serve the browser from the Bun server. Dev uses Vite.
BETTER_AUTH_URL=if(eq($NODE_ENV,production), concat("http://localhost:", $PORT), http://localhost:5173)
EXAMPLE_AUTH_MAIL_URL=if(eq($NODE_ENV,production), http://127.0.0.1:8025)
DATABASE_URL=if(eq($NODE_ENV,production), sqlite://preview.sqlite, sqlite://example.sqlite)

JOBS_SHUTDOWN_TIMEOUT_MS=5000
