{
  "name": "@prinpo/stack-example-fullstack",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "PUBLIC_DEPLOYMENT_NAME=local varlock run --path ./env/server -- bun --watch src/server/index.ts",
    "dev:client": "bunx --bun vp dev --configLoader runner",
    "build": "bun run build:client && bun run build:server",
    "build:client": "bunx --bun vp build",
    "build:server": "_VARLOCK_STATIC_ONLY=1 varlock load --path ./env/server --format json-full > /dev/null && bun build --target bun --packages external src/server/index.ts --outdir dist/server",
    "start": "NODE_ENV=production varlock run --path ./env/server -- bun dist/server/index.js",
    "env:types": "varlock codegen --path ./env/client && varlock codegen --path ./env/server",
    "check": "bunx --bun vp check",
    "logs": "EVLOG_TELEMETRY=0 evlog logs --dir \"${PRINPO_LOG_DIR:-.evlog/logs}\"",
    "logs:errors": "EVLOG_TELEMETRY=0 evlog logs --dir \"${PRINPO_LOG_DIR:-.evlog/logs}\" --what errors",
    "logs:json": "EVLOG_TELEMETRY=0 evlog logs --dir \"${PRINPO_LOG_DIR:-.evlog/logs}\" --json"
  },
  "dependencies": {
    "@prinpo/stack": "file:../..",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
    "vite-plus": "1.2.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3",
      "onFail": "download"
    }
  },
  "varlock": {
    "loadPath": "./env/client/"
  }
}
